LOGIN=
PASSWORD=
GEMINI_API_KEY=

# Consultor de IA (chat em /app/advisor): com ANTHROPIC_API_KEY o chat usa a Anthropic;
# sem ela, usa a chave do Gemini (acima ou na tela Configuração). Modelo da Anthropic
# em DASH_ADVISOR_MODEL (vazio usa claude-opus-5); do Gemini em DASH_ADVISOR_GEMINI_MODEL
# (vazio usa gemini-3.8-flash).
ANTHROPIC_API_KEY=
DASH_ADVISOR_MODEL=
DASH_ADVISOR_GEMINI_MODEL=

PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
DASH_SYNC_SOURCE=
SESSION_SECRET=
DASH_DB_PATH=

# Consulta de nome fantasia por CNPJ na BrasilAPI, sob demanda e desligada por
# padrão: cada consulta conta a um terceiro que este usuário tem relação
# comercial com aquele CNPJ. Use 1, true ou sim para ligar.
DASH_CNPJ_LOOKUP=
