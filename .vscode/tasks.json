{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preparar a base local",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Migrar o banco",
        "Criar o usuário do .env",
        "Carregar as movimentações"
      ],
      "problemMatcher": []
    },
    {
      "label": "Migrar o banco",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.migrate"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Criar o usuário do .env",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.auth.seed"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Carregar as movimentações",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.ingest"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
